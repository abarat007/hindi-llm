# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.env
.python-version

# ---- uv ----
uv.lock

# ---- Editors / OS ----
.vscode/
.idea/
.DS_Store

# ---- Testing / coverage ----
.pytest_cache/
.coverage
htmlcov/

# ---- Experiment tracking ----
wandb/
*.wandb

# ---- Large data: never commit corpora ----
data/raw/*
data/interim/*
data/processed/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
# The one exception: a tiny sample used by smoke tests.
!data/sample_hindi.txt
!data/sample_sft.jsonl

# ---- Tokenizer artifacts (regenerated by scripts) ----
tokenizer/
*.tokenizer.json

# ---- Model checkpoints / outputs ----
checkpoints/*
!checkpoints/.gitkeep
outputs/*
!outputs/.gitkeep

# ---- Encoded binary datasets ----
*.bin
*.idx
*.npy
